7. modul_03_telemetri_ve_protokoller/ring_buffer_crc16.c
mod3_c = """#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#define RING_SIZE 32U /* Ikinin kuvveti olmak zorundadir */
typedef struct {
uint8_t data[RING_SIZE];
volatile uint32_t head;
volatile uint32_t tail;
} RingBuffer;
bool rb_push(RingBuffer rb, uint8_t byte) {
uint32_t next = (rb->head + 1U) & (RING_SIZE - 1U);
if (next == rb->tail) return false; / Dolu */
rb->data[rb->head] = byte;
rb->head = next;
return true;
}
bool rb_pop(RingBuffer *rb, uint8_t out) {
if (rb->head == rb->tail) return false; / Bos */
*out = rb->data[rb->tail];
rb->tail = (rb->tail + 1U) & (RING_SIZE - 1U);
return true;
}
uint16_t crc16_ccitt(const uint8_t *buf, size_t len) {
uint16_t crc = 0xFFFFU;
for (size_t i = 0; i < len; i++) {
crc ^= (uint16_t)buf[i] << 8;
for (int b = 0; b < 8; b++) {
crc = (crc & 0x8000U) ? (uint16_t)((crc << 1) ^ 0x1021U) : (uint16_t)(crc << 1);
}
}
return crc;
}
#pragma pack(push, 1)
typedef struct {
uint16_t header;
uint32_t seq;
int32_t  altitude_mm;
uint16_t crc;
} FramePacket;
#pragma pack(pop)
int main(void) {
RingBuffer rb = { .head = 0, .tail = 0 };
FramePacket pkt = { .header = 0xAA55U, .seq = 1U, .altitude_mm = 125400 };
pkt.crc = crc16_ccitt((const uint8_t *)&pkt, sizeof(FramePacket) - sizeof(uint16_t));
const uint8_t *raw = (const uint8_t *)&pkt;
for (size_t i = 0; i < sizeof(FramePacket); i++) {
rb_push(&rb, raw[i]);
}
uint8_t rx_buf[sizeof(FramePacket)];
for (size_t i = 0; i < sizeof(FramePacket); i++) {
rb_pop(&rb, &rx_buf[i]);
}
FramePacket *rx_pkt = (FramePacket *)rx_buf;
uint16_t check = crc16_ccitt(rx_buf, sizeof(FramePacket) - sizeof(uint16_t));
printf("[MODUL 03] Paket Boyutu: %zu byte | Irtifa: %d mm | CRC: 0x%04X (%s)\n",
sizeof(FramePacket), rx_pkt->altitude_mm, rx_pkt->crc,
(check == rx_pkt->crc) ? "DOGRULANDI" : "HATA");
return 0;
}
"""
8. modul_04_sayisal_cozuculer/rk4_integrator.c
mod4_c = """#include <stdio.h>
#include <math.h>
/* Basit harmonik osilator ve sonumleme modeli: x'' + 2zetawnx' + wn^2x = 0 */
typedef struct {
double x;
double v;
} State1D;
static State1D deriv(State1D s, double wn, double zeta) {
State1D ds;
ds.x = s.v;
ds.v = -2.0 * zeta * wn * s.v - (wn * wn) * s.x;
return ds;
}
static State1D add_scaled(State1D a, State1D b, double dt) {
State1D out = { a.x + b.x * dt, a.v + b.v * dt };
return out;
}
State1D rk4_step(State1D s, double dt, double wn, double zeta) {
State1D k1 = deriv(s, wn, zeta);
State1D k2 = deriv(add_scaled(s, k1, 0.5 * dt), wn, zeta);
State1D k3 = deriv(add_scaled(s, k2, 0.5 * dt), wn, zeta);
State1D k4 = deriv(add_scaled(s, k3, dt), wn, zeta);
State1D next;
next.x = s.x + (dt / 6.0) * (k1.x + 2.0 * k2.x + 2.0 * k3.x + k4.x);
next.v = s.v + (dt / 6.0) * (k1.v + 2.0 * k2.v + 2.0 * k3.v + k4.v);
return next;
}
int main(void) {
State1D s = { .x = 1.0, .v = 0.0 };
double dt = 0.01;
double wn = 4.0;
double zeta = 0.15;
for (int step = 0; step <= 200; step++) {
if (step % 50 == 0) {
printf("[MODUL 04] t=%.2f s | Konum x=%.5f | Hiz v=%.5f\n", step * dt, s.x, s.v);
}
s = rk4_step(s, dt, wn, zeta);
}
return 0;
}
"""
