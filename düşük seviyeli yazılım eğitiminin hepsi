guide_md = """# Düşük Seviyeli Yazılım Eğitimi — Tam Ders Notları ve Uygulama Rehberi
Modül 1: Donanım Mimarisi, Bit İşlemleri ve Bellek Yönetimi
1.1 Bellek Segmentleri
 * Text (.text): Derlenmiş makine komutlarının bulunduğu salt okunur alan.
 * Data (.data): İlk değeri atanmış global ve static değişkenler.
 * BSS (.bss): İlk değeri atanmamış (sıfırlanmış) global ve static değişkenler.
 * Stack: Fonksiyon çağrıları, yerel değişkenler ve dönüş adresleri (LIFO, hızlı, sabit sınırlı).
 * Heap: Dinamik bellek alanı (malloc/free). Gerçek zamanlı sistemlerde parçalanma (fragmentation) ve belirsiz gecikme nedeniyle kaçınılır; bunun yerine Statik Bellek Havuzu (Static Memory Pool) kullanılır.
1.2 Bit Düzeyinde Operatörler
 * Bit kurma (Set): REG |= (1U << BIT_POS);
 * Bit temizleme (Clear): REG &= ~(1U << BIT_POS);
 * Bit tersleme (Toggle): REG ^= (1U << BIT_POS);
 * Bit okuma (Read): uint8_t val = (REG >> BIT_POS) & 1U;
Modül 2: Assembly ve Çekirdek (Kernel) Başlangıç Yapısı
2.1 İşlemci Yazmaçları ve Çağrı Kuralları
 * x86_64 System V ABI: İlk 6 tam sayı argümanı sırasıyla RDI, RSI, RD拜, RCX, R8, R9 yazmaçlarıyla taşınır; dönüş değeri RAX içindedir.
 * ARM Cortex-M: İlk 4 argüman R0-R3 yazmaçlarıyla taşınır; LR (R14) dönüş adresini, PC (R15) program sayacını tutar.
 * Volatile Anahtar Kelimesi: Derleyicinin donanım yazmaçlarına yapılan okuma/yazma işlemlerini optimize ederek silmesini engeller (volatile uint32_t *).
2.2 Deterministik Süper Döngü (Super-Loop) ve Zamanlayıcı
Harici bir işletim sistemi olmadan çalışan bare-metal sistemlerde her görev kesin zaman dilimlerinde (tick) tetiklenir.
Modül 3: Gerçek Zamanlı Veri İletişimi ve Telemetri
3.1 Halka Tampon (Ring Buffer)
Kesme hizmet rutinleri (ISR) ile ana döngü arasında kilit (mutex) gerektirmeden güvenli veri aktarımı sağlar. İndeksleme ikinin kuvveti boyutlarda index = (index + 1) & (SIZE - 1) maskesiyle tek saat çevriminde yapılır.
3.2 İkili Paketleme ve CRC-16
#pragma pack(push, 1) ile yapı hizalama boşlukları (padding) kapatılır ve paket bütünlüğü CRC-16-CCITT (0x1021 polinomu) ile doğrulanır.
Modül 4: Sayısal Çözücüler ve Donanım Dostu Fizik Motorları
Fiziksel sistemlerin diferansiyel denklemleri (\dot{x} = f(t, x)), sabit \Delta t adım aralığıyla 4. mertebe Runge-Kutta (RK4) yöntemi kullanılarak deterministik biçimde çözülür.
"""
5. modul_01_bellek_ve_bitler/static_pool.c
mod1_c = """#include <stdio.h>
#include <stdint.h>
#include <stdbool.h>
#include <string.h>
#define BLOCK_SIZE 64U
#define BLOCK_COUNT 16U
typedef struct {
uint8_t buffer[BLOCK_COUNT][BLOCK_SIZE];
uint16_t alloc_mask; /* Her bit bir bellek blogunun durumunu tutar (0: bos, 1: dolu) */
} StaticMemoryPool;
void pool_init(StaticMemoryPool *pool) {
pool->alloc_mask = 0U;
memset(pool->buffer, 0, sizeof(pool->buffer));
}
void *pool_alloc(StaticMemoryPool *pool) {
for (uint8_t i = 0; i < BLOCK_COUNT; i++) {
if ((pool->alloc_mask & (1U << i)) == 0U) {
pool->alloc_mask |= (1U << i);
return (void )pool->buffer[i];
}
}
return NULL; / Havuz dolu */
}
bool pool_free(StaticMemoryPool *pool, void *ptr) {
uintptr_t base = (uintptr_t)pool->buffer;
uintptr_t addr = (uintptr_t)ptr;
if (addr < base || addr >= base + sizeof(pool->buffer)) return false;
if ((addr - base) % BLOCK_SIZE != 0U) return false;
uint8_t index = (uint8_t)((addr - base) / BLOCK_SIZE);
pool->alloc_mask &= ~(1U << index);
return true;
}
int main(void) {
StaticMemoryPool pool;
pool_init(&pool);
uint8_t *blk1 = (uint8_t *)pool_alloc(&pool);
uint8_t *blk2 = (uint8_t *)pool_alloc(&pool);
if (blk1 && blk2) {
blk1[0] = 0xAA;
blk2[0] = 0x55;
printf("[MODUL 01] Tahsis Maskesi: 0x%04X | blk1[0]=0x%02X, blk2[0]=0x%02X\n",
pool.alloc_mask, blk1[0], blk2[0]);
}
pool_free(&pool, blk1);
printf("[MODUL 01] blk1 serbest birakildi. Yeni Maske: 0x%04X\n", pool.alloc_mask);
return 0;
}
"""
